index 0000000..2b0a708
--- /dev/null
+++ b/.github/workflows/zply-phase11.yml
@@ -0,0 +1,80 @@
+name: zply Phase 11 verification
+
+on:
+  push:
+    paths:
+      - 'zply/**'
+      - '.github/workflows/zply-phase11.yml'
+  pull_request:
+    paths:
+      - 'zply/**'
+      - '.github/workflows/zply-phase11.yml'
+  schedule:
+    - cron: '17 3 * * 1'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: phase11-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
+jobs:
+  correctness:
+    name: ${{ matrix.os }} / ${{ matrix.optimize }}
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-24.04, macos-15, macos-15-intel]
+        optimize: [Debug, ReleaseSafe, ReleaseFast]
+    defaults:
+      run:
+        working-directory: zply
+    steps:
+      - name: Check out source
+        uses: actions/checkout@v4
+      - name: Install Zig 0.17.1
+        uses: mlugg/setup-zig@v2
+        with:
+          version: 0.17.1
+      - name: Verify compiler and architecture
+        run: |
+          zig version
+          uname -a
+      - name: Run all unit and integration tests
+        run: zig build test -Doptimize=${{ matrix.optimize }}
+      - name: Run permanent regression corpus
+        run: zig build test-regression -Doptimize=${{ matrix.optimize }}
+      - name: Check source formatting and comparator
+        if: matrix.optimize == 'Debug'
+        run: |
+          zig fmt --check tests/phase11_regression_test.zig benchmarks/phase11_performance.zig
+          python3 scripts/test_compare_phase11.py
+
+  extended:
+    name: Extended fault, stress and fuzz checks
+    if: github.event_name == 'schedule' || github.event_name == 'workflow_dispatch'
+    runs-on: ubuntu-24.04
+    defaults:
+      run:
+        working-directory: zply
+    steps:
+      - uses: actions/checkout@v4
+      - uses: mlugg/setup-zig@v2
+        with:
+          version: 0.17.1
+      - name: Fault and lifecycle validation
+        run: |
+          zig build test-faults -Doptimize=ReleaseSafe
+          zig build test-concurrency -Doptimize=ReleaseSafe
+          zig build test-ownership-memory -Doptimize=ReleaseSafe
+      - name: Large-stream stress tests
+        run: zig build test-stress -Doptimize=ReleaseSafe
+      - name: Bounded Phase 11 fuzz campaigns
+        run: |
+          zig build fuzz-phase11 --fuzz=1000
+          zig build fuzz-valid-ply --fuzz=1000
+          zig build fuzz-differential --fuzz=1000
+          zig build fuzz-metamorphic --fuzz=1000
